# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# the template is tracked; real env files are not
!.env.example

!.env.mainnet.example

# The app installs with npm (package-lock.json). Vercel picks the package manager from the
# lockfile it finds, so a stray pnpm lockfile would switch production builds to pnpm.
pnpm-lock.yaml
pnpm-workspace.yaml
