# Production template — copy to .env.local (and to Vercel → Environment Variables). See docs/DEPLOY.md.
# Linkr on Solana / StonkFun (Raydium LaunchLab) — copy to .env.local

# --- cluster ---
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta            # mainnet-beta | devnet | localnet
NEXT_PUBLIC_RPC_URL=https://mainnet.helius-rpc.com/?api-key=<helius key>   # browser RPC (Helius/QuickNode in production)
INDEXER_RPC_URL=https://mainnet.helius-rpc.com/?api-key=<helius key>                             # server RPC for the indexer/keeper (falls back to NEXT_PUBLIC_RPC_URL)
NEXT_PUBLIC_VAULT_MODE=custodial
NEXT_PUBLIC_PROGRAM_ID=99n7VGd6132b4UUwhSezLm9xXssdnJFiSPrEKkCuMHPF
INDEXER_TX_BATCH=5                           # parsed transactions per RPC call (raise on a paid endpoint)

# --- database ---
MONGODB_URI=mongodb://user:pass@host:27017/causa?authSource=admin
MONGODB_DB=linkr-mainnet

# --- secrets ---
CRON_SECRET=<openssl rand -hex 32>                                 # bearer for /api/cron/*
ADMIN_SECRET=<openssl rand -hex 32>                                # x-admin-secret for /api/admin/resync

# --- keeper ---
KEEPER_PRIVATE_KEY=<base58 secret of ~/.config/solana/linkr-keeper-mainnet.json>                          # base58 secret (or JSON byte array); must be the program's operator
PROTOCOL_RECIPIENT=<wallet that receives the 5% protocol share>                          # wallet that receives the protocol share (WSOL ATA is created on first harvest)

# --- dividend keeper tuning ---
DIVIDEND_MIN_HARVEST=0.05                   # whole units of the vault's quote token (SOL for SOL-quoted vaults) idle on the vault before a harvest
DIVIDEND_MAX_SLIPPAGE_BPS=100
DIVIDEND_SWAP=jupiter                        # jupiter | mock (devnet, keeper is the basket mint authority) | off
DIVIDEND_MOCK_PRICE=0.0001                   # mock mode: output raw units per lamport
DIVIDEND_DUST_UNITS=1000                     # legs below this many raw units roll forward instead of getting an epoch
DIVIDEND_AUTOCLAIM=1
DIVIDEND_AUTOCLAIM_MIN_USD=2
DIVIDEND_AUTOCLAIM_DELAY_S=0
DIVIDEND_AUTOCLAIM_RETRY_S=1800
DIVIDEND_AUTOCLAIM_MAX_PER_RUN=50
DIVIDEND_EXCLUDED=                           # extra owners that never earn dividends, comma separated

# --- swaps / prices ---
JUPITER_API_KEY=                             # portal.jup.ag; empty uses the free lite-api.jup.ag tier
# JUPITER_API_BASE=https://api.jup.ag

# --- StonkFun / Raydium LaunchLab ---
# LAUNCHLAB_PLATFORM_ID=                     # leave unset on mainnet: defaults to StonkFun standard 4E876qZTE9FJMrBzgVtBrSrzz2TLivB5Y5QXPjB4gZL7
# LAUNCHLAB_CURVE_RULE_ID=                   # optional
# STONKFUN_API_ORIGIN=https://www.stonkfun.xyz   # StonkFun public API (300 req/min per IP, no key)
PINATA_JWT=<pinata jwt>                      # pins launch metadata to IPFS via Pinata

# --- Vercel Blob (coin logos) ---
BLOB_READ_WRITE_TOKEN=

# --- Newswire AI enrichment (optional) ---
OPENROUTER_TOKEN=
OPENROUTER_MODEL=openai/gpt-5.6-luna

# --- Telegram launch bot (optional) ---
# After deploying: ENV_FILE=.env.mainnet npm run telegram:setup (points the bot's webhook at NEXT_PUBLIC_SITE_URL)
TELEGRAM_BOT_TOKEN=<from @BotFather>
TELEGRAM_WEBHOOK_SECRET=<openssl rand -hex 32>
TELEGRAM_WALLET_SECRET=<openssl rand -base64 48>   # seeds every user's bot wallet: losing it loses them, leaking it exposes them — back it up like KEEPER_PRIVATE_KEY

# --- site ---
NEXT_PUBLIC_SITE_URL=https://<your domain>

# --- custodial mode policy (replaces the on-chain Config) ---
PROTOCOL_SHARE_BPS=500
DISPUTE_WINDOW_S=600
CLAIM_WINDOW_S=15552000
MIN_EPOCH_LENGTH_S=3600
VAULT_PAUSED=0
BASKET_ALLOWLIST=NVDA,TSLA,AAPL,MSFT,GOOGL,AMZN,META,SPY,QQQ,COIN,HOOD,MSTR,CRCL
