# Linkr on Solana / StonkFun (Raydium LaunchLab) — copy to .env.local

# --- cluster ---
NEXT_PUBLIC_SOLANA_CLUSTER=devnet            # mainnet-beta | devnet | localnet
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com   # browser RPC (Helius/QuickNode in production)
INDEXER_RPC_URL=                             # server RPC for the indexer/keeper (falls back to NEXT_PUBLIC_RPC_URL)
# custodial: vaults are keeper-derived wallets, accounting off-chain, roots on-chain as memos (no deploy cost) — the supported mode
# program: the on-chain causa_vault program owns vaults (trustless, ~2.1 SOL rent) — deferred until it is rebuilt to read LaunchLab pools
NEXT_PUBLIC_VAULT_MODE=custodial
NEXT_PUBLIC_PROGRAM_ID=99n7VGd6132b4UUwhSezLm9xXssdnJFiSPrEKkCuMHPF
INDEXER_TX_BATCH=5                           # parsed transactions per RPC call (raise on a paid endpoint)

# --- database ---
MONGODB_URI=mongodb://user:pass@host:27017/causa?authSource=admin
MONGODB_DB=linkr

# --- secrets ---
CRON_SECRET=                                 # bearer for /api/cron/*
ADMIN_SECRET=                                # x-admin-secret for /api/admin/resync

# --- keeper ---
KEEPER_PRIVATE_KEY=                          # base58 secret (or JSON byte array); must be the program's operator
PROTOCOL_RECIPIENT=                          # wallet that receives the protocol share (WSOL ATA is created on first harvest)

# --- dividend keeper tuning ---
DIVIDEND_MIN_HARVEST=0.05                   # whole units of the vault's quote token (SOL for SOL-quoted vaults) idle on the vault before a harvest
DIVIDEND_MAX_SLIPPAGE_BPS=100
DIVIDEND_SWAP=jupiter                        # jupiter | mock (devnet, keeper is the basket mint authority) | off
DIVIDEND_MOCK_PRICE=0.0001                   # mock mode: output raw units per lamport
DIVIDEND_DUST_UNITS=1000                     # legs below this many raw units roll forward instead of getting an epoch
DIVIDEND_AUTOCLAIM=on
DIVIDEND_AUTOCLAIM_MIN_USD=1
DIVIDEND_AUTOCLAIM_DELAY_S=0
DIVIDEND_AUTOCLAIM_RETRY_S=1800
DIVIDEND_AUTOCLAIM_MAX_PER_RUN=50
DIVIDEND_EXCLUDED=                           # extra owners that never earn dividends, comma separated
KEEPER_SWAP_FLOAT_SOL=0.05                   # SOL the keeper lends a vault for one swap (covers accounts a route opens); keep more than this on the keeper
KEEPER_LOW_SOL=0.05                          # the keeper logs an error every run while its wallet holds less than this

# --- swaps / prices ---
JUPITER_API_KEY=                             # portal.jup.ag; empty uses the free lite-api.jup.ag tier
# JUPITER_API_BASE=https://api.jup.ag

# --- StonkFun / Raydium LaunchLab ---
LAUNCHLAB_PLATFORM_ID=                       # devnet: required — Linkr's own LaunchLab platform, printed by `npm run platform:devnet` (StonkFun's platform is mainnet-only)
                                             # mainnet: optional override; empty = StonkFun standard 4E876qZTE9FJMrBzgVtBrSrzz2TLivB5Y5QXPjB4gZL7
# LAUNCHLAB_CURVE_RULE_ID=                   # optional
LAUNCHLAB_RAISE=85                           # devnet only: curve raise target in whole quote units (devnet configs: SOL and mock USDC USDCoctVLVnvTXBEuP9s8hntucdJokbo17RwHuNXemT)
# STONKFUN_API_ORIGIN=https://www.stonkfun.xyz   # StonkFun public API (/api/public/v1: pairs, tokens, launches, stats; 300 req/min per IP, no key)
PINATA_JWT=                                  # pins launch metadata to IPFS via Pinata

# --- Vercel Blob (coin logos) ---
BLOB_READ_WRITE_TOKEN=

# --- Newswire AI enrichment (optional) ---
OPENROUTER_TOKEN=
OPENROUTER_MODEL=openai/gpt-5.6-luna

# --- Telegram launch bot (optional; custodial mode only) ---
# Local: use a separate dev bot and `npm run telegram:dev` (long polling). Deployed: `npm run telegram:setup` once.
TELEGRAM_BOT_TOKEN=                          # from @BotFather
TELEGRAM_WEBHOOK_SECRET=                     # any random string (openssl rand -hex 32); Telegram echoes it on every webhook call
TELEGRAM_WALLET_SECRET=                      # 32+ random chars (openssl rand -base64 48); seeds every user's bot wallet — back it up like KEEPER_PRIVATE_KEY

# --- site ---
NEXT_PUBLIC_SITE_URL=

# --- custodial mode config (replaces the on-chain Config; ignored in program mode) ---
PROTOCOL_SHARE_BPS=500                       # 5% of harvested fees to PROTOCOL_RECIPIENT (max 2000)
DISPUTE_WINDOW_S=600                         # review window after a payout is published
CLAIM_WINDOW_S=15552000                      # 180 days before an unclaimed payout expires back into the pot
MIN_EPOCH_LENGTH_S=3600                      # shortest payout period a creator may pick
VAULT_PAUSED=0                               # 1 stops harvests/publishes/deliveries (claims already delivered are unaffected)
BASKET_ALLOWLIST=NVDA,TSLA,AAPL,MSFT,GOOGL,AMZN,META,SPY,QQQ,COIN,HOOD,MSTR,CRCL   # tickers, xStocks symbols or raw mints
